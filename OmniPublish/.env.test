# OmniPublish 测试环境变量
# 这是一个示例,展示如何配置 Dev.to 和 Hashnode

# ==================== 国际平台 API Keys ====================

# Dev.to API Key (必填)
DEVTO_API_KEY=your_devto_api_key_here

# Hashnode Access Token 和 Publication ID (可选)
HASHNODE_TOKEN=your_hashnode_token_here
HASHNODE_PUBLICATION_ID=your_publication_id_here

# Medium Integration Token (可选,暂时不用)
MEDIUM_TOKEN=

# ==================== 图床配置 (暂时留空) ====================

R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ==================== 全局配置 ====================

# 主站地址 (可选)
CANONICAL_BASE_URL=

# 日志级别
LOG_LEVEL=INFO
