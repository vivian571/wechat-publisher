# OmniPublish 环境变量配置示例
# 复制此文件为 .env 并填入真实的 API Keys

# ==================== 国际平台 API Keys ====================

# Dev.to API Key
# 获取方式: https://dev.to/settings/extensions
DEVTO_API_KEY=your_devto_api_key_here

# Hashnode Access Token 和 Publication ID
# 获取方式: https://hashnode.com/settings/developer
HASHNODE_TOKEN=your_hashnode_token_here
HASHNODE_PUBLICATION_ID=your_publication_id_here

# Medium Integration Token
# 获取方式: https://medium.com/me/settings
MEDIUM_TOKEN=your_medium_token_here

# Twitter/X API Credentials
# 获取方式: https://developer.twitter.com/en/portal/dashboard
# 需要申请 Twitter Developer Account 并创建 App
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

# ==================== 国内平台凭证 ====================

# 掘金 Cookie
# 获取方式: 登录掘金后,F12 → Network → 复制 Cookie
JUEJIN_COOKIE=sessionid=xxx; sessionid_ss=xxx

# 微信公众号 AppID 和 AppSecret
# 获取方式: 公众平台 → 开发 → 基本配置
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret

# CSDN Cookie
# 获取方式: 登录 CSDN 后,F12 → Network → 复制 Cookie
CSDN_COOKIE=your_csdn_cookie_here

# ==================== 图床配置 ====================

# Cloudflare R2 配置
# 获取方式: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET_NAME=omnipublish-assets
R2_PUBLIC_URL=https://assets.yourdomain.com

# ==================== 通知配置 (可选) ====================

# Telegram Bot 通知
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ==================== 全局配置 ====================

# 主站地址 (用于 canonical URL)
CANONICAL_BASE_URL=https://myblog.com

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ==================== 代理配置 (可选) ====================

# HTTP/HTTPS 代理 (用于访问国际平台 API)
# 格式: http://host:port 或 socks5://host:port
HTTP_PROXY=http://127.0.0.1:3067
HTTPS_PROXY=http://127.0.0.1:3067

# 是否启用代理 (true/false)
USE_PROXY=true
